# Copy this file to .env.local and fill in the values.
# Every service below has a free tier that does not require a credit card.

# Public URL of the app (used for auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API Keys (https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Google AI Studio → Get API key (https://aistudio.google.com/apikey)
# Server-only: never prefix with NEXT_PUBLIC_
GOOGLE_GENERATIVE_AI_API_KEY=
